API_PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zyvon_ai?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
