# Server-side AI coach provider. Keep this key out of all VITE_ variables.
# If unset, the API clearly labels and uses its rule-based starter response.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
